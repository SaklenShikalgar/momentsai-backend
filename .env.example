# AWS console se jo Access Key ID / Secret Access Key mila tha, wahi yahan daalo
AWS_ACCESS_KEY_ID=yaha_apni_access_key_daalo
AWS_SECRET_ACCESS_KEY=yaha_apni_secret_key_daalo
AWS_REGION=ap-south-1

# Jo naam S3 bucket banate waqt diya tha
S3_BUCKET_NAME=yaha_apna_bucket_naam_daalo

# Jo collection-id Rekognition me banaya tha
REKOGNITION_COLLECTION_ID=wedding-guest-faces

# Backend kis port par chalega
PORT=5000
